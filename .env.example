# Miljøvariabler til VBAdmin
#
# Kopiér denne fil til .env.local ved lokal udvikling, og udfyld værdierne.
# .env.local må aldrig committes.
#
# I produktion og preview sættes variablerne som miljøvariabler i Vercel
# (Project Settings → Environment Variables), ikke i repositoryet.
#
# Begge variabler læses udelukkende server-side i lib/supabase-admin.ts.
# SUPABASE_SERVICE_ROLE_KEY giver fuld adgang til databasen og må aldrig
# eksponeres til browseren eller committes.

SUPABASE_URL=

# Bruges kun af adminfladen. Omgår rækkesikkerhed og har fuld adgang.
SUPABASE_SERVICE_ROLE_KEY=

# Bruges af de offentlige baneplansider, /baneplan/efteraar-foraar og
# /baneplan/vinter. Adgangen begrænses af rækkesikkerhed i Supabase, så nøglen
# kun kan læse planer med status = 'live'. Se supabase/rls-offentlig-laesning.sql.
#
# Bevidst uden NEXT_PUBLIC-præfiks: de offentlige sider er Server Components, så
# nøglen skal ikke sendes til browseren.
#
# Bruges også af den offentlige lokalebooking, /lokalebooking/*, som ikke kun
# læser men også opretter bookinger. Adgangen er stadig begrænset af
# rækkesikkerhed: nøglen kan kun læse viewet lokale_optagethed, som ingen
# persondata indeholder, og kun indsætte i de kolonner, der er givet rettighed
# til. Se supabase/lokalebooking-skema.sql.
SUPABASE_ANON_KEY=

# Salt til hashning af IP-adresser i lokalebookingens forsøgstælling.
#
# En vilkårlig, lang, tilfældig streng, fx fra `openssl rand -hex 32`. Den skal
# være ens i produktion og preview, men behøver ikke være den samme lokalt.
#
# Kun hashen gemmes, aldrig adressen selv. Saltet er nødvendigt, fordi der findes
# så få IPv4-adresser, at en usaltet hash kan opregnes bagfra — og databasen
# ville dermed reelt indeholde adresserne.
#
# Mangler variablen, afvises alle bookinger med en generisk fejl, og årsagen
# skrives i serverloggen. Det er bevidst: modulet skal ikke kunne køre videre med
# forsøgstællingen slået fra.
BOOKING_IP_SALT=

# Afsendelse af mails fra lokalebookingen gennem SMTP hos One.com.
#
# Værdier for One.com: SMTP_HOST=send.one.com, SMTP_PORT=465 (SSL/TLS),
# SMTP_USER=booking@vejleboldklub.dk. SMTP_PASS er postkassens adgangskode og
# hører kun hjemme i Vercel — aldrig i repositoryet.
#
# Port 465 betyder SSL/TLS fra første byte. Sættes en anden port, fx 587, bruges
# STARTTLS i stedet. Det udledes af portnummeret, så der ikke findes en variabel
# mere, der kan sættes forkert.
#
# Mangler én af dem, sendes der ingen mails, men bookinger oprettes stadig, og
# årsagen skrives i serverloggen. Det er bevidst: en mailserver, der er nede, må
# ikke kunne afvise en booking, brugeren har udfyldt korrekt.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Afsenderen på alle mails fra modulet, uanset transport. Er den ikke sat, bruges
# RESEND_FROM_EMAIL, og ellers "Lokalebooking VB Parken <booking@vejleboldklub.dk>".
#
# Hos One.com skal adressen høre til den postkasse, der logges ind på med
# SMTP_USER. En fremmed afsenderadresse bliver afvist af serveren.
MAIL_FROM=

# Hvilken transport der bruges: "smtp" (standard) eller "resend".
#
# Findes kun, indtil SMTP-løsningen er afprøvet i produktion. Viser den sig ikke
# at holde, er "resend" vejen tilbage uden en kodeændring — sæt variablen i
# Vercel og redeploy. Når SMTP har vist sig at virke, fjernes variablen,
# mail-resend.ts og resend-afhængigheden i én omgang.
MAIL_TRANSPORT=

# Nøglen til Resend. Bruges kun, når MAIL_TRANSPORT=resend.
#
# Domænet vejleboldklub.dk er verificeret i Resend, med SPF og DKIM sat op hos
# One.com. Lad nøglen blive stående i Vercel, indtil SMTP er afprøvet.
RESEND_API_KEY=

# Tidligere navn for afsenderadressen. Læses fortsat, hvis MAIL_FROM ikke er sat,
# så en eksisterende opsætning ikke skifter afsender. Brug MAIL_FROM til nye.
RESEND_FROM_EMAIL=

# Sidens egen adresse, brugt til at bygge godkend- og afvis-links i mails.
#
# Kan normalt stå tom: adressen tages fra den forespørgsel, mailen udspringer af,
# så et preview-deployment af sig selv laver links til sig selv. Sæt den kun, hvis
# links skal pege et bestemt sted hen uanset hvor koden kører, fx
# https://vbadmin.vercel.app
APP_BASE_URL=

# Adgang til adminfladen sker med rigtige brugerlogins gennem Supabase Auth.
#
# ADMIN_BASIC_AUTH er fjernet. Den var ét delt kodeord til hele adminfladen og
# er erstattet af Administration-modulet: hver bruger logger ind med sin egen
# adresse, og adgangen pr. modul styres i tabellen admin_users.
#
# Der skal ikke sættes nye miljøvariabler til login. Supabase Auth bruger
# SUPABASE_URL og SUPABASE_ANON_KEY, som allerede står ovenfor, og
# brugeropslaget bruger SUPABASE_SERVICE_ROLE_KEY.
#
# To ting skal derimod sættes i Supabase-dashboardet, ikke her:
#   Authentication → URL Configuration → Redirect URLs skal indeholde
#     <sidens adresse>/auth/bekraeft
#   Authentication → Emails → Invite user skal pege på samme sted med
#     token_hash. Standardskabelonen lægger tokenet efter et #, og et fragment
#     sendes aldrig til serveren.
#
# Sæt desuden SMTP op under Project Settings → Auth. Supabases indbyggede
# afsender er kraftigt begrænset og ikke beregnet til produktion. One.com-
# oplysningerne ovenfor kan genbruges.
#
# Automatisk logud ved inaktivitet kræver også noget i dashboardet.
#
# Grænserne i browseren står i lib/inaktivitet.ts: advarsel efter 29 minutter,
# logud efter 30. Det er brugerfladen. En timer i browseren kan slås fra med
# udviklerværktøjer, og sessionscookien vil stadig være gyldig — derfor skal
# serversiden sættes op, ellers er logud kun kosmetisk:
#
#   Authentication → Sessions → Inactivity timeout = 30 minutter
#     Den egentlige spærre. Supabase afviser en session, hvis refresh-tokenet
#     ikke er brugt inden for perioden. Kræver Pro-plan eller nyere.
#
#   Authentication → Sessions → JWT expiry = 1800 sekunder (30 minutter)
#     Hvor længe et access token gælder. Sætter IKKE i sig selv en grænse for
#     sessionen: klienten fornyer automatisk med refresh-tokenet, så en lav værdi
#     giver blot flere fornyelser. Værdien har betydning sammen med Inactivity
#     timeout, fordi sessionens faktiske levetid er timeout plus JWT expiry.
#     Standardværdien er 3600.
#
# Er projektet på Free-planen, findes Inactivity timeout ikke, og JWT expiry
# alene giver ingen begrænsning. Så er timeren i browseren den eneste kontrol,
# og det skal være et bevidst valg — ikke en antagelse om, at serveren dækker.
