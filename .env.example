# Miljøvariabler til VBAdmin
#
# Kopiér denne fil til .env.local ved lokal udvikling, og udfyld værdierne.
# .env.local må aldrig committes.
#
# I produktion og preview sættes variablerne som miljøvariabler i Vercel
# (Project Settings → Environment Variables), ikke i repositoryet.
#
# Begge variabler læses udelukkende server-side i lib/supabase-admin.ts.
# SUPABASE_SERVICE_ROLE_KEY giver fuld adgang til databasen og må aldrig
# eksponeres til browseren eller committes.

SUPABASE_URL=

# Bruges kun af adminfladen. Omgår rækkesikkerhed og har fuld adgang.
SUPABASE_SERVICE_ROLE_KEY=

# Bruges af de offentlige baneplansider, /baneplan/efteraar-foraar og
# /baneplan/vinter. Adgangen begrænses af rækkesikkerhed i Supabase, så nøglen
# kun kan læse planer med status = 'live'. Se supabase/rls-offentlig-laesning.sql.
#
# Bevidst uden NEXT_PUBLIC-præfiks: de offentlige sider er Server Components, så
# nøglen skal ikke sendes til browseren.
SUPABASE_ANON_KEY=
